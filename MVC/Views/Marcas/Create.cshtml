@model PuntoDeVenta.MVC.Models.MarcaUpsertViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nueva Marca</title>
</head>
<body>
    <h2>Nueva Marca</h2>
    @Html.ValidationSummary(excludePropertyErrors: false)

    @using (Html.BeginForm("Create", "Marcas", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div>
            @Html.LabelFor(m => m.Nombre)
            @Html.TextBoxFor(m => m.Nombre)
            @Html.ValidationMessageFor(m => m.Nombre)
        </div>

        <div>
            @Html.LabelFor(m => m.Descripcion)
            @Html.TextAreaFor(m => m.Descripcion, 4, 40, htmlAttributes: null)
        </div>

        <button type="submit">Guardar</button>
        @Html.ActionLink("Volver", "Index")
    }
</body>
</html>
