@model PuntoDeVentaEntities.Compras.CompraDTO
@using System.Collections.Generic
@using PuntoDeVentaEntities.Catalogos
@{
    ViewBag.Title = "Compras";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
    var proveedores = ViewBag.Proveedores as List<Proveedor> ?? new List<Proveedor>();
    var selectSucursales = new SelectList(sucursales, "Id", "Nombre", Model.SucursalId);
    var selectProveedores = new SelectList(proveedores, "Id", "Nombre", Model.ProveedorId);
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <h3 class="section-title"><i class="fas fa-truck-loading me-2"></i>Compras a Proveedor</h3>

    <form id="frmCompra" name="frmCompra" method="post">
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.CreadoPor)
        @Html.HiddenFor(x => x.FechaCreacion)
        @Html.HiddenFor(x => x.ModificadoPor)
        @Html.HiddenFor(x => x.FechaModificacion)
        @Html.HiddenFor(x => x.Estatus)

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Sucursal</label>
                    @Html.DropDownListFor(x => x.SucursalId, selectSucursales,
                        "-- Seleccione sucursal --",
                        new { @class = "form-select", id = "SucursalId" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Proveedor</label>
                    @Html.DropDownListFor(x => x.ProveedorId, selectProveedores,
                        "-- Seleccione proveedor --",
                        new { @class = "form-select", id = "ProveedorId" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Folio</label>
                    @Html.TextBoxFor(x => x.Folio, new { @class = "form-control", placeholder = "Folio de la compra" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Fecha de Compra</label>
                    <input type="date" id="FechaCompra" name="FechaCompra" class="form-control"
                           value="@(Model.FechaCompra == default(System.DateTime) ? string.Empty : Model.FechaCompra.ToString("yyyy-MM-dd"))" />
                </div>
            </div>
            <div class="col-md-8">
                <div class="mb-3">
                    <label>Observaciones</label>
                    @Html.TextBoxFor(x => x.Observaciones, new { @class = "form-control", placeholder = "Observaciones de la compra" })
                </div>
            </div>
        </div>

        <hr />
        <h5 class="section-title"><i class="fas fa-boxes me-2"></i>Detalle</h5>

        <div class="row align-items-end">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Producto</label>
                    <select id="cmbProducto" class="form-select">
                        <option value="">-- Seleccione producto --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <div class="mb-3">
                    <label>Cantidad</label>
                    <input type="number" id="txtCantidad" class="form-control" min="0" step="0.0001" value="1" onkeyup="ActualizarImportePreview()" onchange="ActualizarImportePreview()" />
                </div>
            </div>
            <div class="col-md-2">
                <div class="mb-3">
                    <label>Costo Unitario</label>
                    <input type="number" id="txtCosto" class="form-control" min="0" step="0.0001" value="0" onkeyup="ActualizarImportePreview()" onchange="ActualizarImportePreview()" />
                </div>
            </div>
            <div class="col-md-2">
                <div class="mb-3">
                    <label>Importe</label>
                    <input type="text" id="txtImporte" class="form-control" readonly value="0.00" />
                </div>
            </div>
            <div class="col-md-2">
                <div class="mb-3">
                    <button type="button" class="btn btn-primary w-100" onclick="AgregarDetalle()">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 table-responsive">
                <table class="table table-bordered" id="tblDetalleCompra">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Costo Unitario</th>
                            <th>Importe</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div class="row justify-content-end">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Subtotal</label>
                    <input type="text" id="Subtotal" class="form-control" readonly value="0.00" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Impuesto</label>
                    <input type="number" id="Impuesto" class="form-control" min="0" step="0.0001" value="0" onkeyup="RecalcularTotales()" onchange="RecalcularTotales()" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Total</label>
                    <input type="text" id="Total" class="form-control" readonly value="0.00" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <input type="button" value="Guardar" class="btn btn-success" onclick="GuardarCompra()" />
                    <a href="/Compra/Index" class="btn btn-warning">Cancelar</a>
                </div>
            </div>
        </div>
    </form>

    <hr />
    <h5 class="section-title"><i class="fas fa-list me-2"></i>Historial de Compras</h5>
    <div class="row">
        <div class="col-md-12 table-responsive">
            <div class="mb-3">
                <table id="tblCompra"></table>
            </div>
        </div>
    </div>
</div>

<script>
    var detalle = [];

    $(function () {
        $("#frmCompra").validate({
            rules: {
                "SucursalId": { required: true },
                "ProveedorId": { required: true }
            },
            messages: {
                "SucursalId": { required: "La sucursal es requerida." },
                "ProveedorId": { required: "El proveedor es requerido." }
            },
            errorElement: "span",
            errorClass: "text-danger",
            highlight: function (element) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element) {
                $(element).removeClass("is-invalid").addClass("is-valid");
            },
            errorPlacement: function (error, element) {
                error.insertAfter(element);
            }
        });
    });

    $(document).ready(function () {
        new DataTable('#tblCompra', {
            columns: [
                { data: 'Id', title: 'ID', visible: false },
                { data: 'SucursalNombre', title: 'Sucursal' },
                { data: 'ProveedorNombre', title: 'Proveedor' },
                { data: 'Folio', title: 'Folio' },
                {
                    data: 'FechaCompra', title: 'Fecha', render: function (data) {
                        return data ? formatDate(data) : '';
                    }
                },
                { data: 'Subtotal', title: 'Subtotal', render: function (d) { return formatMoney(d); } },
                { data: 'Impuesto', title: 'Impuesto', render: function (d) { return formatMoney(d); } },
                { data: 'Total', title: 'Total', render: function (d) { return formatMoney(d); } },
                {
                    data: 'Id', title: 'Acciones', render: function (data) {
                        var html = '<div class="d-flex gap-3">';
                        html += '<button type="button" class="btn btn-sm btn-outline-primary" onclick="EditarCompra(' + data + ')"><i class="fas fa-edit"></i></button>';
                        html += '<button type="button" class="btn btn-sm btn-outline-danger" onclick="EliminarCompra(event, ' + data + ')"><i class="fas fa-trash-alt"></i></button>';
                        html += '</div>';
                        return html;
                    }
                },
                { data: 'Estatus', title: 'Estatus', visible: false }
            ],
            language: {
                url: "/Content/datatables/i18n/es-ES.json"
            }
        });

        if (!$("#FechaCompra").val()) {
            $("#FechaCompra").val(new Date().toISOString().substring(0, 10));
        }

        ConsultarProductos();
        ConsultarTodasLasCompras();
        CargarDetalleExistente();
    });

    function ConsultarProductos() {
        GetMVC("/Compra/ConsultarProductos", function (r) {
            var result = typeof r == 'string' ? JSON.parse(r) : r;

            if (result.IsSuccess && result.Response) {
                var cmb = $("#cmbProducto");
                result.Response.forEach(function (p) {
                    cmb.append($('<option>', { value: p.Id, text: p.Nombre }));
                });
            }
        });
    }

    function ConsultarTodasLasCompras() {
        GetMVC("/Compra/ConsultarTodasLasCompras", function (r) {
            var result = typeof r == 'string' ? JSON.parse(r) : r;

            if (result.IsSuccess) {
                MapingPropertiesDataTable("tblCompra", result.Response);
            } else {
                Swal.fire({
                    title: 'Error',
                    text: result.Message,
                    icon: 'error',
                    confirmButtonText: 'Aceptar',
                    background: 'white',
                    confirmButtonColor: '#4e73df'
                });
            }
        });
    }

    function CargarDetalleExistente() {
        var inicial = @Html.Raw(ViewBag.DetalleJson);

        if (inicial && inicial.length > 0) {
            inicial.forEach(function (d) {
                detalle.push({
                    ProductoId: d.ProductoId,
                    ProductoNombre: d.ProductoNombre || d.ProductoId,
                    Cantidad: d.Cantidad,
                    CostoUnitario: d.CostoUnitario,
                    Importe: d.Importe
                });
            });

            RenderDetalle();
        }
    }

    function ActualizarImportePreview() {
        var cantidad = parseFloat($("#txtCantidad").val() || 0);
        var costo = parseFloat($("#txtCosto").val() || 0);
        $("#txtImporte").val((cantidad * costo).toFixed(2));
    }

    function AgregarDetalle() {
        var productoId = parseInt($("#cmbProducto").val() || 0);
        var productoNombre = $("#cmbProducto option:selected").text();
        var cantidad = parseFloat($("#txtCantidad").val() || 0);
        var costo = parseFloat($("#txtCosto").val() || 0);

        if (productoId <= 0) {
            Swal.fire({ title: 'Validación', text: 'Seleccione un producto.', icon: 'warning', confirmButtonText: 'Aceptar', background: 'white', confirmButtonColor: '#4e73df' });
            return;
        }

        if (cantidad <= 0) {
            Swal.fire({ title: 'Validación', text: 'La cantidad debe ser mayor a cero.', icon: 'warning', confirmButtonText: 'Aceptar', background: 'white', confirmButtonColor: '#4e73df' });
            return;
        }

        if (costo < 0) {
            Swal.fire({ title: 'Validación', text: 'El costo unitario no puede ser negativo.', icon: 'warning', confirmButtonText: 'Aceptar', background: 'white', confirmButtonColor: '#4e73df' });
            return;
        }

        detalle.push({
            ProductoId: productoId,
            ProductoNombre: productoNombre,
            Cantidad: cantidad,
            CostoUnitario: costo,
            Importe: cantidad * costo
        });

        RenderDetalle();

        $("#cmbProducto").val("");
        $("#txtCantidad").val(1);
        $("#txtCosto").val(0);
        $("#txtImporte").val("0.00");
    }

    function RenderDetalle() {
        var tbody = $("#tblDetalleCompra tbody");
        tbody.empty();

        detalle.forEach(function (d, i) {
            var tr = $("<tr>");
            tr.append($("<td>").text(d.ProductoNombre || d.ProductoId));
            tr.append($("<td>").text(d.Cantidad));
            tr.append($("<td>").text(formatMoney(d.CostoUnitario)));
            tr.append($("<td>").text(formatMoney(d.Importe)));

            var td = $("<td>");
            var btn = $('<button type="button" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash-alt"></i></button>');
            btn.on('click', function () {
                detalle.splice(i, 1);
                RenderDetalle();
            });
            td.append(btn);
            tr.append(td);

            tbody.append(tr);
        });

        RecalcularTotales();
    }

    function RecalcularTotales() {
        var subtotal = 0;
        detalle.forEach(function (d) {
            subtotal += (d.Importe || 0);
        });

        var impuesto = parseFloat($("#Impuesto").val() || 0);

        $("#Subtotal").val(subtotal.toFixed(2));
        $("#Total").val((subtotal + impuesto).toFixed(2));
    }

    function GuardarCompra() {
        if (!$("#frmCompra").valid()) {
            return;
        }

        if (detalle.length === 0) {
            Swal.fire({ title: 'Validación', text: 'La compra debe incluir al menos un producto.', icon: 'warning', confirmButtonText: 'Aceptar', background: 'white', confirmButtonColor: '#4e73df' });
            return;
        }

        Swal.fire({
            title: 'Guardando...',
            text: 'Por favor espere',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        var compra = {
            Id: parseInt($("#Id").val() || 0),
            SucursalId: parseInt($("#SucursalId").val() || 0),
            ProveedorId: parseInt($("#ProveedorId").val() || 0),
            Folio: $("#Folio").val(),
            FechaCompra: $("#FechaCompra").val() ? new Date($("#FechaCompra").val()).toISOString() : new Date().toISOString(),
            Subtotal: parseFloat($("#Subtotal").val() || 0),
            Impuesto: parseFloat($("#Impuesto").val() || 0),
            Total: parseFloat($("#Total").val() || 0),
            Observaciones: $("#Observaciones").val(),
            CreadoPor: $("#CreadoPor").val(),
            FechaCreacion: new Date().toISOString(),
            ModificadoPor: $("#ModificadoPor").val() || null,
            FechaModificacion: null,
            Estatus: true,
            Detalle: detalle
        };

        PostJSON('/Compra/GuardarCompra', compra, function (response) {
            Swal.close();

            if (response.IsSuccess) {
                Swal.fire({
                    title: '¡Éxito!',
                    text: response.Message,
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false,
                    background: 'white',
                    iconColor: '#4e73df'
                }).then(() => {
                    window.location.href = '/Compra/Index';
                });
            } else {
                Swal.fire({
                    title: 'Error',
                    text: response.Message,
                    icon: 'error',
                    confirmButtonText: 'Aceptar',
                    background: 'white',
                    confirmButtonColor: '#4e73df'
                });
            }
        });
    }

    // El detalle es anidado; se envía como JSON para que el model binder de MVC
    // lo materialice correctamente (PostMVC usa form-urlencoded, no soporta listas anidadas).
    function PostJSON(url, payload, callback) {
        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(payload),
            dataType: 'json',
            success: callback,
            error: callback
        });
    }

    function EditarCompra(id) {
        window.location.href = '/Compra/Index/' + id;
    }

    function EliminarCompra(event, id) {
        Swal.fire({
            title: '¿Está seguro?',
            text: 'Esta acción eliminará lógicamente el registro',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#e74a3b',
            cancelButtonColor: '#858796'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Eliminando...',
                    text: 'Por favor espere',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                var compra = {
                    Id: id,
                    ModificadoPor: $("#ModificadoPor").val() || "system",
                    FechaModificacion: new Date().toISOString()
                };

                PostMVC('/Compra/EliminarCompra', compra, function (response) {
                    Swal.close();

                    if (response.IsSuccess) {
                        Swal.fire({
                            title: '¡Eliminado!',
                            text: response.Message,
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false,
                            background: 'white',
                            iconColor: '#4e73df'
                        }).then(() => {
                            ConsultarTodasLasCompras();
                        });
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: response.Message,
                            icon: 'error',
                            confirmButtonText: 'Aceptar',
                            background: 'white',
                            confirmButtonColor: '#4e73df'
                        });
                    }
                });
            }
        });

        return false;
    }
</script>
