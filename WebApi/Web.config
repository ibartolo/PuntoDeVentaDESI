<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="cCon" connectionString="Server=__SQL_HOST__;Database=db_9c7990_puntoventadev;User Id=__SQL_USER__;Password=__SQL_PASSWORD__;Encrypt=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="owin:AppStartup" value="PuntoDeVenta.WebApi.App_Start.Startup, WebApi" />
    <add key="owin:AutomaticAppStartup" value="true" />
    <add key="AllowInsecureHttp" value="true" />
    <add key="client_id" value="PuntoDeVentaMVC" />
    <add key="client_secret" value="__SET_IN_ENV_OR_TRANSFORM__" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <machineKey validationKey="__SET_IN_ENV_OR_DEPLOYMENT__" decryptionKey="__SET_IN_ENV_OR_DEPLOYMENT__" validation="SHA1" decryption="AES" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
</configuration>
