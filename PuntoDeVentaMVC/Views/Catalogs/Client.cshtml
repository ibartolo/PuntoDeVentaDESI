@model PuntoDeVentaEntities.Catalogos.Cliente
@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <h3 class="section-title"><i class="fas fa-users me-2"></i>Catálogo de Clientes</h3>

    <form id="frmCliente" name="frmCliente" method="post">
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.CreadoPor)
        @Html.HiddenFor(x => x.FechaCreacion)
        @Html.HiddenFor(x => x.ModificadoPor)
        @Html.HiddenFor(x => x.FechaModificacion)
        @Html.HiddenFor(x => x.Estatus)

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label>Nombre</label>
                    @Html.TextBoxFor(x => x.Nombre, new { @class = "form-control", placeholder = "Nombre del cliente" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label>Correo</label>
                    @Html.TextBoxFor(x => x.Correo, new { @class = "form-control", placeholder = "Correo electrónico" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Teléfono</label>
                    @Html.TextBoxFor(x => x.Telefono, new { @class = "form-control", placeholder = "Teléfono" })
                </div>
            </div>
            <div class="col-md-8">
                <div class="mb-3">
                    <label>Dirección</label>
                    @Html.TextBoxFor(x => x.Direccion, new { @class = "form-control", placeholder = "Dirección" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3 form-check">
                    @Html.CheckBoxFor(x => x.EsPublicoGeneral, new { @class = "form-check-input" })
                    <label class="form-check-label">Cliente "Público General"</label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <input type="button" value="Guardar" class="btn btn-success" onclick="GuardarActualizarCliente()" />
                    <a href="/Catalogs/Client" class="btn btn-warning">Cancelar</a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 table-responsive">
                <div class="mb-3">
                    <table id="tblCliente"></table>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    $(function () {
        $("#frmCliente").validate({
            rules: {
                "Nombre": { required: true, maxlength: 150 },
                "Correo": { email: true, maxlength: 250 }
            },
            messages: {
                "Nombre": {
                    required: "El campo 'Nombre' es requerido.",
                    maxlength: "El nombre no puede superar los 150 caracteres."
                },
                "Correo": {
                    email: "El correo no tiene un formato válido.",
                    maxlength: "El correo no puede superar los 250 caracteres."
                }
            },
            errorElement: "span",
            errorClass: "text-danger",
            highlight: function (element) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element) {
                $(element).removeClass("is-invalid").addClass("is-valid");
            },
            errorPlacement: function (error, element) {
                error.insertAfter(element);
            }
        });
    });

    $(document).ready(function () {
        var tabla = new DataTable('#tblCliente', {
            columns: [
                { data: 'Id', title: 'ID', visible: false },
                { data: 'Nombre', title: 'Nombre' },
                { data: 'Correo', title: 'Correo' },
                { data: 'Telefono', title: 'Teléfono' },
                { data: 'Direccion', title: 'Dirección' },
                {
                    data: 'EsPublicoGeneral', title: 'Público General', render: function (data) {
                        return data ? 'Sí' : 'No';
                    }
                },
                {
                    data: 'Id', title: 'Acciones', render: function (data) {
                        var html = '<div class="d-flex gap-3">';
                        html += '<button type="button" class="btn btn-sm btn-outline-primary" onclick="EditarCliente(' + data + ')"><i class="fas fa-edit"></i></button>';
                        html += '<button type="button" class="btn btn-sm btn-outline-danger" onclick="EliminarCliente(event, ' + data + ')"><i class="fas fa-trash-alt"></i></button>';
                        html += '</div>';
                        return html;
                    }
                },
                { data: 'Estatus', title: 'Estatus', visible: false }
            ],
            language: {
                url: "/Content/datatables/i18n/es-ES.json"
            }
        });
        ConsultarTodosClientes();
    });

    function GuardarActualizarCliente() {
        if ($("#frmCliente").valid()) {
            Swal.fire({
                title: 'Guardando...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            var cliente = {
                Id: $("#Id").val() || 0,
                Nombre: $("#Nombre").val(),
                Correo: $("#Correo").val(),
                Telefono: $("#Telefono").val(),
                Direccion: $("#Direccion").val(),
                EsPublicoGeneral: $("#EsPublicoGeneral").is(":checked"),
                CreadoPor: $("#CreadoPor").val(),
                FechaCreacion: new Date().toISOString(),
                ModificadoPor: $("#ModificadoPor").val() || null,
                FechaModificacion: null,
                Estatus: true
            };

            PostMVC('/Catalogs/GuardarActualizarClientes', cliente, function (response) {
                Swal.close();

                if (response.IsSuccess) {
                    Swal.fire({
                        title: '¡Éxito!',
                        text: response.Message,
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false,
                        background: 'white',
                        iconColor: '#4e73df'
                    }).then(() => {
                        window.location.href = '/Catalogs/Client';
                    });
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: response.Message,
                        icon: 'error',
                        confirmButtonText: 'Aceptar',
                        background: 'white',
                        confirmButtonColor: '#4e73df'
                    });
                }
            });
        }
    }

    function ConsultarTodosClientes() {
        GetMVC("/Catalogs/ConsultarTodosLosClientes", function (r) {
            var result = typeof r == 'string' ? JSON.parse(r) : r;

            if (result.IsSuccess) {
                MapingPropertiesDataTable("tblCliente", result.Response);
            } else {
                Swal.fire({
                    title: 'Error',
                    text: result.Message,
                    icon: 'error',
                    confirmButtonText: 'Aceptar',
                    background: 'white',
                    confirmButtonColor: '#4e73df'
                });
            }
        });
    }

    function EditarCliente(id) {
        window.location.href = '/Catalogs/Client/' + id;
    }

    function EliminarCliente(event, id) {
        Swal.fire({
            title: '¿Está seguro?',
            text: 'Esta acción eliminará lógicamente el registro',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#e74a3b',
            cancelButtonColor: '#858796'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Eliminando...',
                    text: 'Por favor espere',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                var cliente = {
                    Id: id,
                    ModificadoPor: $("#ModificadoPor").val() || "system",
                    FechaModificacion: new Date().toISOString()
                };

                PostMVC('/Catalogs/EliminarClientes', cliente, function (response) {
                    Swal.close();

                    if (response.IsSuccess) {
                        Swal.fire({
                            title: '¡Eliminado!',
                            text: response.Message,
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false,
                            background: 'white',
                            iconColor: '#4e73df'
                        }).then(() => {
                            ConsultarTodosClientes();
                            $("#frmCliente")[0].reset();
                            $("#Id").val(0);
                        });
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: response.Message,
                            icon: 'error',
                            confirmButtonText: 'Aceptar',
                            background: 'white',
                            confirmButtonColor: '#4e73df'
                        });
                    }
                });
            }
        });

        return false;
    }
</script>
