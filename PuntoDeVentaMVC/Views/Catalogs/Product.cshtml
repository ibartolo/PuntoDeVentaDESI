@model PuntoDeVentaEntities.Catalogos.Producto
@using System.Collections.Generic
@using PuntoDeVentaEntities.Catalogos
@{
    ViewBag.Title = "Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categorias = ViewBag.Categorias as List<CategoriaDTO> ?? new List<CategoriaDTO>();
    var marcas = ViewBag.Marcas as List<Marca> ?? new List<Marca>();
    var selectCategorias = new SelectList(categorias, "Id", "Nombre", Model.CategoriaId);
    var selectMarcas = new SelectList(marcas, "Id", "Nombre", Model.MarcaId);
    var tiposProducto = new SelectList(new[] { "Comprado", "Fabricado" }, Model.TipoProducto);
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <h3 class="section-title"><i class="fas fa-box me-2"></i>Catálogo de Productos</h3>

    <form id="frmProducto" name="frmProducto" method="post">
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.EmpresaId)
        @Html.HiddenFor(x => x.CreadoPor)
        @Html.HiddenFor(x => x.FechaCreacion)
        @Html.HiddenFor(x => x.ModificadoPor)
        @Html.HiddenFor(x => x.FechaModificacion)
        @Html.HiddenFor(x => x.Estatus)

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Nombre</label>
                    @Html.TextBoxFor(x => x.Nombre, new { @class = "form-control", placeholder = "Nombre del producto" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Código (barras / QR)</label>
                    @Html.TextBoxFor(x => x.Codigo, new { @class = "form-control", placeholder = "Código único" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Tipo de producto</label>
                    @Html.DropDownListFor(x => x.TipoProducto, tiposProducto, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Categoría</label>
                    @Html.DropDownListFor(x => x.CategoriaId, selectCategorias, "-- Sin categoría --", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Marca</label>
                    @Html.DropDownListFor(x => x.MarcaId, selectMarcas, "-- Sin marca --", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Marca (texto libre)</label>
                    @Html.TextBoxFor(x => x.MarcaTexto, new { @class = "form-control", placeholder = "Marca genérica" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Unidad de medida</label>
                    @Html.TextBoxFor(x => x.UnidadMedida, new { @class = "form-control", placeholder = "Pieza, kg, lt..." })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Stock mínimo</label>
                    @Html.TextBoxFor(x => x.StockMinimo, new { @class = "form-control", type = "number", step = "0.0001", min = "0" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Foto (URL)</label>
                    @Html.TextBoxFor(x => x.FotoUrl, new { @class = "form-control", placeholder = "https://..." })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label>Descripción</label>
                    @Html.TextBoxFor(x => x.Descripcion, new { @class = "form-control", placeholder = "Descripción del producto" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <input type="button" value="Guardar" class="btn btn-success" onclick="GuardarActualizarProducto()" />
                    <a href="/Catalogs/Product" class="btn btn-warning">Cancelar</a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 table-responsive">
                <div class="mb-3">
                    <table id="tblProducto"></table>
                </div>
            </div>
        </div>
    </form>
</div>

@if (Model.Id > 0)
{
    <div class="form-section" id="precioSection">
        <h3 class="section-title"><i class="fas fa-tag me-2"></i>Precios del producto</h3>

        <form id="frmPrecio" name="frmPrecio" method="post">
            <input type="hidden" id="PrecioProductoId" name="PrecioProductoId" value="@Model.Id" />

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label>Precio de compra</label>
                        <input type="number" id="PrecioCompra" name="PrecioCompra" class="form-control" step="0.0001" min="0" value="0" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label>Precio venta sugerido</label>
                        <input type="number" id="PrecioVentaSugerido" name="PrecioVentaSugerido" class="form-control" step="0.0001" min="0" value="0" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label>Precio de venta</label>
                        <input type="number" id="PrecioVenta" name="PrecioVenta" class="form-control" step="0.0001" min="0" value="0" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3">
                        <input type="button" value="Guardar precio" class="btn btn-success" onclick="GuardarPrecio()" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 table-responsive">
                    <div class="mb-3">
                        <table id="tblPrecio"></table>
                    </div>
                </div>
            </div>
        </form>
    </div>
}

<script>
    $(function () {
        $("#frmProducto").validate({
            rules: {
                "Nombre": { required: true, maxlength: 150 },
                "Codigo": { maxlength: 100 },
                "UnidadMedida": { maxlength: 30 },
                "MarcaTexto": { maxlength: 100 },
                "FotoUrl": { maxlength: 300 }
            },
            messages: {
                "Nombre": {
                    required: "El campo 'Nombre' es requerido.",
                    maxlength: "El nombre no puede superar los 150 caracteres."
                },
                "Codigo": {
                    maxlength: "El código no puede superar los 100 caracteres."
                },
                "UnidadMedida": {
                    maxlength: "La unidad de medida no puede superar los 30 caracteres."
                },
                "MarcaTexto": {
                    maxlength: "La marca no puede superar los 100 caracteres."
                },
                "FotoUrl": {
                    maxlength: "La URL de la foto no puede superar los 300 caracteres."
                }
            },
            errorElement: "span",
            errorClass: "text-danger",
            highlight: function (element) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element) {
                $(element).removeClass("is-invalid").addClass("is-valid");
            },
            errorPlacement: function (error, element) {
                error.insertAfter(element);
            }
        });
    });

    $(document).ready(function () {
        new DataTable('#tblProducto', {
            columns: [
                { data: 'Id', title: 'ID', visible: false },
                { data: 'Nombre', title: 'Nombre' },
                { data: 'Codigo', title: 'Código' },
                { data: 'CategoriaNombre', title: 'Categoría' },
                { data: 'MarcaNombre', title: 'Marca' },
                { data: 'TipoProducto', title: 'Tipo' },
                { data: 'UnidadMedida', title: 'Unidad' },
                { data: 'PrecioVenta', title: 'Precio venta' },
                { data: 'StockMinimo', title: 'Stock mínimo' },
                {
                    data: 'Id', title: 'Acciones', render: function (data) {
                        var html = '<div class="d-flex gap-3">';
                        html += '<button type="button" class="btn btn-sm btn-outline-primary" onclick="EditarProducto(' + data + ')"><i class="fas fa-edit"></i></button>';
                        html += '<button type="button" class="btn btn-sm btn-outline-info" onclick="EditarProducto(' + data + ')"><i class="fas fa-tag"></i></button>';
                        html += '<button type="button" class="btn btn-sm btn-outline-danger" onclick="EliminarProducto(event, ' + data + ')"><i class="fas fa-trash-alt"></i></button>';
                        html += '</div>';
                        return html;
                    }
                },
                { data: 'Estatus', title: 'Estatus', visible: false }
            ],
            language: {
                url: "/Content/datatables/i18n/es-ES.json"
            }
        });

        ConsultarTodosProductos();

        if ($("#precioSection").length > 0) {
            new DataTable('#tblPrecio', {
                columns: [
                    { data: 'Id', title: 'ID', visible: false },
                    { data: 'PrecioCompra', title: 'Compra' },
                    { data: 'PrecioVentaSugerido', title: 'Sugerido' },
                    { data: 'PrecioVenta', title: 'Venta' },
                    {
                        data: 'Activo', title: 'Activo', render: function (data) {
                            return data ? 'Sí' : 'No';
                        }
                    },
                    {
                        data: 'FechaInicio', title: 'Inicio', render: function (data) {
                            return data ? new Date(data).toLocaleString() : '';
                        }
                    },
                    {
                        data: 'FechaFin', title: 'Fin', render: function (data) {
                            return data ? new Date(data).toLocaleString() : '';
                        }
                    }
                ],
                language: {
                    url: "/Content/datatables/i18n/es-ES.json"
                }
            });

            ConsultarPrecioActivo(@Model.Id);
            ConsultarPreciosPorProducto(@Model.Id);
        }
    });

    function GuardarActualizarProducto() {
        if ($("#frmProducto").valid()) {
            Swal.fire({
                title: 'Guardando...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            var producto = {
                Id: $("#Id").val() || 0,
                EmpresaId: $("#EmpresaId").val() || 0,
                Nombre: $("#Nombre").val(),
                Codigo: $("#Codigo").val(),
                CategoriaId: $("#CategoriaId").val() || null,
                MarcaId: $("#MarcaId").val() || null,
                MarcaTexto: $("#MarcaTexto").val(),
                TipoProducto: $("#TipoProducto").val(),
                UnidadMedida: $("#UnidadMedida").val(),
                StockMinimo: parseFloat($("#StockMinimo").val() || 0),
                FotoUrl: $("#FotoUrl").val(),
                Descripcion: $("#Descripcion").val(),
                CreadoPor: $("#CreadoPor").val(),
                FechaCreacion: new Date().toISOString(),
                ModificadoPor: $("#ModificadoPor").val() || null,
                FechaModificacion: null,
                Estatus: true
            };

            PostMVC('/Catalogs/GuardarActualizarProducto', producto, function (response) {
                Swal.close();

                if (response.IsSuccess) {
                    Swal.fire({
                        title: '¡Éxito!',
                        text: response.Message,
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false,
                        background: 'white',
                        iconColor: '#4e73df'
                    }).then(() => {
                        window.location.href = '/Catalogs/Product';
                    });
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: response.Message,
                        icon: 'error',
                        confirmButtonText: 'Aceptar',
                        background: 'white',
                        confirmButtonColor: '#4e73df'
                    });
                }
            });
        }
    }

    function ConsultarTodosProductos() {
        GetMVC("/Catalogs/ConsultarTodosLosProductos", function (r) {
            var result = typeof r == 'string' ? JSON.parse(r) : r;

            if (result.IsSuccess) {
                MapingPropertiesDataTable("tblProducto", result.Response);
            } else {
                Swal.fire({
                    title: 'Error',
                    text: result.Message,
                    icon: 'error',
                    confirmButtonText: 'Aceptar',
                    background: 'white',
                    confirmButtonColor: '#4e73df'
                });
            }
        });
    }

    function EditarProducto(id) {
        window.location.href = '/Catalogs/Product/' + id;
    }

    function EliminarProducto(event, id) {
        Swal.fire({
            title: '¿Está seguro?',
            text: 'Esta acción eliminará lógicamente el registro',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#e74a3b',
            cancelButtonColor: '#858796'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Eliminando...',
                    text: 'Por favor espere',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                var producto = {
                    Id: id,
                    ModificadoPor: $("#ModificadoPor").val() || "system",
                    FechaModificacion: new Date().toISOString()
                };

                PostMVC('/Catalogs/EliminarProducto', producto, function (response) {
                    Swal.close();

                    if (response.IsSuccess) {
                        Swal.fire({
                            title: '¡Eliminado!',
                            text: response.Message,
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false,
                            background: 'white',
                            iconColor: '#4e73df'
                        }).then(() => {
                            ConsultarTodosProductos();
                            $("#frmProducto")[0].reset();
                            $("#Id").val(0);
                        });
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: response.Message,
                            icon: 'error',
                            confirmButtonText: 'Aceptar',
                            background: 'white',
                            confirmButtonColor: '#4e73df'
                        });
                    }
                });
            }
        });

        return false;
    }

    function ConsultarPrecioActivo(productoId) {
        GetMVC("/Catalogs/ConsultarPrecioActivo?productoId=" + productoId, function (r) {
            var result = typeof r == 'string' ? JSON.parse(r) : r;

            if (result && result.IsSuccess && result.Response) {
                $("#PrecioCompra").val(result.Response.PrecioCompra);
                $("#PrecioVentaSugerido").val(result.Response.PrecioVentaSugerido);
                $("#PrecioVenta").val(result.Response.PrecioVenta);
            }
        });
    }

    function ConsultarPreciosPorProducto(productoId) {
        GetMVC("/Catalogs/ConsultarPreciosPorProducto?productoId=" + productoId, function (r) {
            var result = typeof r == 'string' ? JSON.parse(r) : r;

            if (result && result.IsSuccess) {
                MapingPropertiesDataTable("tblPrecio", result.Response);
            }
        });
    }

    function GuardarPrecio() {
        var productoId = parseInt($("#PrecioProductoId").val() || 0, 10);
        if (productoId <= 0) {
            return;
        }

        Swal.fire({
            title: 'Guardando...',
            text: 'Por favor espere',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        var precio = {
            ProductoId: productoId,
            PrecioCompra: parseFloat($("#PrecioCompra").val() || 0),
            PrecioVentaSugerido: parseFloat($("#PrecioVentaSugerido").val() || 0),
            PrecioVenta: parseFloat($("#PrecioVenta").val() || 0),
            Activo: true,
            FechaInicio: new Date().toISOString(),
            CreadoPor: $("#CreadoPor").val(),
            FechaCreacion: new Date().toISOString(),
            Estatus: true
        };

        PostMVC('/Catalogs/GuardarActualizarPrecio', precio, function (response) {
            Swal.close();

            if (response.IsSuccess) {
                Swal.fire({
                    title: '¡Éxito!',
                    text: response.Message,
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false,
                    background: 'white',
                    iconColor: '#4e73df'
                }).then(() => {
                    ConsultarPreciosPorProducto(productoId);
                    ConsultarTodosProductos();
                });
            } else {
                Swal.fire({
                    title: 'Error',
                    text: response.Message,
                    icon: 'error',
                    confirmButtonText: 'Aceptar',
                    background: 'white',
                    confirmButtonColor: '#4e73df'
                });
            }
        });
    }
</script>
