@model PuntoDeVenta.MVC.Models.MarcaViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Desactivar Marca</title>
</head>
<body>
    <h2>Desactivar Marca</h2>
    <p><strong>Esta acción no elimina físicamente el registro: solo lo desactiva (Estatus = Inactivo).</strong></p>
    @Html.ValidationSummary(excludePropertyErrors: false)

    @if (Model != null)
    {
        <dl>
            <dt>Id</dt>
            <dd>@Model.Id</dd>

            <dt>Nombre</dt>
            <dd>@Model.Nombre</dd>

            <dt>Descripción</dt>
            <dd>@Model.Descripcion</dd>
        </dl>

        @using (Html.BeginForm("Delete", "Marcas", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("id", Model.Id)
            <button type="submit">Confirmar desactivación</button>
            @Html.ActionLink("Cancelar", "Index")
        }
    }
</body>
</html>
