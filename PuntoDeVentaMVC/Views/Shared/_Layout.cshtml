@{
    var usuarioSesion = PuntoDeVentaMVC.Helpers.SessionHelper.GetSessionUser();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Punto de Venta - @ViewBag.Title</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- ========================================= -->
    <!-- ESTILOS GENERALES DEL TEMPLATE -->
    <!-- ========================================= -->
    <link href="~/CSS/Comun/TemplatePage.css" rel="stylesheet" />

    <!-- ========================================= -->
    <!-- SCRIPTS - jQuery primero, luego Bootstrap -->
    <!-- ========================================= -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Comun/Comun.js"></script>

    <!-- ========================================= -->
    <!-- SCRIPT PARA FUNCIONALIDAD DEL SIDEBAR Y MENÚS -->
    <!-- ========================================= -->
    <script>
        $(document).ready(function () {
            $("#sidebar").empty().load("/Home/MenusUser", function () {
                // =========================================
                // FUNCIONALIDAD DEL SIDEBAR (COLLAPSE)
                // =========================================
                $('#sidebarCollapse').on('click', function () {
                    $('#sidebar').toggleClass('active');
                    $('#content').toggleClass('active');
                });

                // =========================================
                // MANEJO DE SUBMENÚS DESPLEGABLES
                // =========================================
                $('.has-arrow').on('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const $parent = $(this).parent();
                    $('.components li').not($parent).removeClass('active');
                    $parent.toggleClass('active');
                });

                // =========================================
                // MARCAR ENLACES SIN REDIRECCIÓN COMO DESHABILITADOS
                // =========================================
                $('.components a[href="#"]').each(function () {
                    var $a = $(this);
                    if (!$a.hasClass('has-arrow')) {
                        $a.addClass('disabled-module');
                        $a.attr('aria-disabled', 'true');
                        $a.on('click.disabled', function (ev) {
                            ev.preventDefault();
                            ev.stopPropagation();
                        });
                    }
                });

                // =========================================
                // CERRAR SUBMENÚS AL HACER CLIC FUERA
                // =========================================
                $(document).on('click', function (e) {
                    if (!$(e.target).closest('.components li').length) {
                        $('.components li').removeClass('active');
                    }
                });

                // =========================================
                // MANEJO DE RESPONSIVE - CERRAR SIDEBAR EN MÓVIL
                // =========================================
                $('.components a').on('click', function () {
                    if ($(window).width() <= 992) {
                        if (!$(this).hasClass('has-arrow')) {
                            $('#sidebar').removeClass('active');
                            $('#content').removeClass('active');
                        }
                    }
                });

                // =========================================
                // AJUSTE EN CAMBIO DE TAMAÑO DE VENTANA
                // =========================================
                $(window).on('resize', function () {
                    if ($(window).width() > 992) {
                        $('#sidebar, #content').removeClass('active');
                    }
                });
            });
        });
    </script>
</head>
<body class="@(PuntoDeVentaMVC.Helpers.ThemeHelper.GetTemaClase(Request, usuarioSesion))">
    <div class="wrapper">
        <!-- ========================================= -->
        <!-- SIDEBAR - Punto de Venta -->
        <!-- ========================================= -->
        <nav id="sidebar">
        </nav>

        <!-- ========================================= -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ========================================= -->
        <div id="content">
            <!-- Navbar superior con usuario autenticado a la derecha -->
            <nav class="navbar-top">
                <button type="button" id="sidebarCollapse" class="menu-toggle">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="user-menu">
                    <div class="user-details">
                        <div class="user-name">@(usuarioSesion == null ? "Invitado" : usuarioSesion.UserName)</div>
                    </div>
                    <div class="user-avatar">
                        @if (usuarioSesion != null && !string.IsNullOrEmpty(usuarioSesion.ProfileImage) && System.IO.File.Exists(Server.MapPath("~" + usuarioSesion.ProfileImage)))
                        {
                            <img src="@usuarioSesion.ProfileImage" alt="Foto de perfil" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                        }
                        else
                        {
                            @Html.Raw(usuarioSesion == null ? "??" : usuarioSesion.UserAvatar)
                        }
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/User/MyProfile"><i class="fas fa-user me-2"></i> Perfil</a></li>
                            <li><a class="dropdown-item" href="/Home/Configuration"><i class="fas fa-cog me-2"></i> Configuración</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Home/LogOut"><i class="fas fa-sign-out-alt me-2"></i> Cerrar Sesión</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Contenido principal -->
            <div class="main-content">
                @RenderBody()
            </div>
        </div>
    </div>
</body>
</html>
