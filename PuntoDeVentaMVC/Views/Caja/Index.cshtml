@model PuntoDeVentaEntities.Caja.CajaChicaDTO
@{
    ViewBag.Title = "Caja chica";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cajaAbierta = Model != null && Model.Id > 0;
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <h3 class="section-title"><i class="fas fa-cash-register me-2"></i>Caja chica</h3>

    @if (cajaAbierta)
    {
        <div class="row">
            <div class="col-md-3">
                <div class="mb-3">
                    <label>Monto inicial</label>
                    <input type="text" class="form-control" value="@Model.MontoInicial.ToString("N2")" readonly />
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <label>Ingresos totales</label>
                    <input type="text" class="form-control" value="@Model.IngresosTotales.ToString("N2")" readonly />
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <label>Salidas totales</label>
                    <input type="text" class="form-control" value="@Model.SalidasTotales.ToString("N2")" readonly />
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <label>Estado</label>
                    <input type="text" class="form-control" value="@Model.Estado" readonly />
                </div>
            </div>
        </div>

        <form id="frmSalida" name="frmSalida" method="post">
            <h5 class="mt-3">Registrar salida</h5>
            <div class="row">
                <div class="col-md-3">
                    <div class="mb-3">
                        <label>Monto</label>
                        <input type="number" step="0.01" min="0.01" id="SalidaMonto" name="SalidaMonto" class="form-control" placeholder="0.00" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label>Tipo de salida</label>
                        <select id="SalidaTipo" name="SalidaTipo" class="form-control">
                            <option value="Efectivo">Efectivo</option>
                            <option value="Gasto">Gasto</option>
                            <option value="Reembolso">Reembolso</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label>Comentario</label>
                        <input type="text" id="SalidaComentario" name="SalidaComentario" class="form-control" placeholder="Motivo de la salida" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label>Evidencia (URL)</label>
                        <input type="text" id="SalidaEvidencia" name="SalidaEvidencia" class="form-control" placeholder="http://..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3 form-check mt-4">
                        <input type="checkbox" id="SalidaJustificada" name="SalidaJustificada" class="form-check-input" />
                        <label class="form-check-label" for="SalidaJustificada">Justificada</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3">
                        <input type="button" value="Registrar salida" class="btn btn-primary" onclick="RegistrarSalidaCaja()" />
                        <input type="button" value="Cerrar caja" class="btn btn-danger" onclick="CerrarCajaChica()" />
                    </div>
                </div>
            </div>
        </form>

        <div class="row">
            <div class="col-md-12 table-responsive">
                <div class="mb-3">
                    <table id="tblSalidas"></table>
                </div>
            </div>
        </div>
    }
    else
    {
        <form id="frmAbrir" name="frmAbrir" method="post">
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label>Monto inicial</label>
                        <input type="number" step="0.01" min="0" id="MontoInicial" name="MontoInicial" class="form-control" placeholder="0.00" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3">
                        <input type="button" value="Abrir caja" class="btn btn-success" onclick="AbrirCajaChica()" />
                    </div>
                </div>
            </div>
        </form>
    }
</div>

<script>
    var cajaChicaId = @(Model != null ? Model.Id : 0);

    $(function () {
        $("#frmAbrir").validate({
            rules: {
                "MontoInicial": {
                    required: true,
                    number: true,
                    min: 0
                }
            },
            messages: {
                "MontoInicial": {
                    required: "El campo 'Monto inicial' es requerido.",
                    number: "Ingrese un monto válido.",
                    min: "El monto inicial no puede ser negativo."
                }
            },
            errorElement: "span",
            errorClass: "text-danger",
            highlight: function (element) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element) {
                $(element).removeClass("is-invalid").addClass("is-valid");
            },
            errorPlacement: function (error, element) {
                error.insertAfter(element);
            }
        });

        $("#frmSalida").validate({
            rules: {
                "SalidaMonto": {
                    required: true,
                    number: true,
                    min: 0.01
                }
            },
            messages: {
                "SalidaMonto": {
                    required: "El campo 'Monto' es requerido.",
                    number: "Ingrese un monto válido.",
                    min: "El monto de la salida debe ser mayor que cero."
                }
            },
            errorElement: "span",
            errorClass: "text-danger",
            highlight: function (element) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element) {
                $(element).removeClass("is-invalid").addClass("is-valid");
            },
            errorPlacement: function (error, element) {
                error.insertAfter(element);
            }
        });

        if (cajaChicaId > 0 && $("#tblSalidas").length) {
            new DataTable('#tblSalidas', {
                columns: [
                    { data: 'Id', title: 'ID', visible: false },
                    {
                        data: 'FechaHora', title: 'Fecha', render: function (data) {
                            return data ? new Date(data).toLocaleString('es-MX') : '';
                        }
                    },
                    {
                        data: 'Monto', title: 'Monto', render: function (data) {
                            return data != null ? parseFloat(data).toFixed(2) : '0.00';
                        }
                    },
                    { data: 'TipoSalida', title: 'Tipo' },
                    { data: 'Comentario', title: 'Comentario' },
                    {
                        data: 'Justificada', title: 'Justificada', render: function (data) {
                            return data ? 'Sí' : 'No';
                        }
                    }
                ],
                language: {
                    url: "/Content/datatables/i18n/es-ES.json"
                }
            });

            ConsultarSalidasCaja();
        }
    });

    function AbrirCajaChica() {
        if ($("#frmAbrir").valid()) {
            Swal.fire({
                title: 'Abriendo...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            var caja = {
                SucursalId: 0,
                UsuarioId: 0,
                MontoInicial: parseFloat($("#MontoInicial").val()) || 0
            };

            PostMVC('/CajaChica/AbrirCajaChica', caja, function (response) {
                Swal.close();

                if (response.IsSuccess) {
                    Swal.fire({
                        title: '¡Éxito!',
                        text: response.Message,
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false,
                        background: 'white',
                        iconColor: '#4e73df'
                    }).then(() => {
                        window.location.href = '/CajaChica/Index';
                    });
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: response.Message,
                        icon: 'error',
                        confirmButtonText: 'Aceptar',
                        background: 'white',
                        confirmButtonColor: '#4e73df'
                    });
                }
            });
        }
    }

    function RegistrarSalidaCaja() {
        if ($("#frmSalida").valid()) {
            Swal.fire({
                title: 'Registrando...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            var salida = {
                CajaChicaId: cajaChicaId,
                Monto: parseFloat($("#SalidaMonto").val()) || 0,
                Comentario: $("#SalidaComentario").val(),
                TipoSalida: $("#SalidaTipo").val(),
                Justificada: $("#SalidaJustificada").is(":checked"),
                EvidenciaUrl: $("#SalidaEvidencia").val()
            };

            PostMVC('/CajaChica/RegistrarSalidaCaja', salida, function (response) {
                Swal.close();

                if (response.IsSuccess) {
                    Swal.fire({
                        title: '¡Éxito!',
                        text: response.Message,
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false,
                        background: 'white',
                        iconColor: '#4e73df'
                    }).then(() => {
                        window.location.href = '/CajaChica/Index';
                    });
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: response.Message,
                        icon: 'error',
                        confirmButtonText: 'Aceptar',
                        background: 'white',
                        confirmButtonColor: '#4e73df'
                    });
                }
            });
        }
    }

    function CerrarCajaChica() {
        Swal.fire({
            title: '¿Está seguro?',
            text: 'Se cerrará la caja chica actual',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, cerrar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#e74a3b',
            cancelButtonColor: '#858796'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Cerrando...',
                    text: 'Por favor espere',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                PostMVC('/CajaChica/CerrarCajaChica', { id: cajaChicaId }, function (response) {
                    Swal.close();

                    if (response.IsSuccess) {
                        Swal.fire({
                            title: '¡Cerrada!',
                            text: response.Message,
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false,
                            background: 'white',
                            iconColor: '#4e73df'
                        }).then(() => {
                            window.location.href = '/CajaChica/Index';
                        });
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: response.Message,
                            icon: 'error',
                            confirmButtonText: 'Aceptar',
                            background: 'white',
                            confirmButtonColor: '#4e73df'
                        });
                    }
                });
            }
        });

        return false;
    }

    function ConsultarSalidasCaja() {
        GetMVC('/CajaChica/ConsultarSalidasCaja?cajaChicaId=' + cajaChicaId, function (r) {
            var result = typeof r == 'string' ? JSON.parse(r) : r;

            if (result.IsSuccess) {
                MapingPropertiesDataTable("tblSalidas", result.Response);
            } else {
                Swal.fire({
                    title: 'Error',
                    text: result.Message,
                    icon: 'error',
                    confirmButtonText: 'Aceptar',
                    background: 'white',
                    confirmButtonColor: '#4e73df'
                });
            }
        });
    }
</script>
